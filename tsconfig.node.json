{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/engine/**/*.ts",
    "src/shared/**/*.ts",
    "src/qa/**/*.ts",
    "src/cli/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": ["src/engine/runtime/client/**", "node_modules", "data", "dist"]
}
