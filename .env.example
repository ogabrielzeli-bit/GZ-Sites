# ===============================
# GZ OS — variáveis de ambiente
# Copie para .env e ajuste. NUNCA commite o .env.
# ===============================

# Porta do servidor (API + dashboard em produção)
PORT=4800
# Host (0.0.0.0 para expor na rede local / hospedagem)
HOST=127.0.0.1

# Pasta de dados (banco SQLite, uploads, auditorias, prévias, projetos).
# Fica fora do código para que atualizar o GZ OS nunca apague seus prospects.
GZ_DATA_DIR=./data

# Token simples de acesso ao painel (opcional, mas recomendado se hospedar na internet).
# Se vazio, o painel fica aberto (use só em localhost).
GZ_ACCESS_TOKEN=

# -------------------------------
# IA OPCIONAL — o GZ OS funciona 100% com AI_PROVIDER=none
# -------------------------------
# none | openai | anthropic | openai-compatible
AI_PROVIDER=none

# OpenAI (só usado se AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (só usado se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Qualquer API compatível com OpenAI (Ollama, LM Studio, Groq, etc.)
# Ex.: http://localhost:11434/v1 para Ollama
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# -------------------------------
# NETLIFY (opcional — só para deploy via API; o export ZIP não precisa)
# -------------------------------
NETLIFY_AUTH_TOKEN=

# -------------------------------
# AUDITOR
# -------------------------------
# Tempo máximo (ms) para carregar um site auditado
AUDIT_TIMEOUT_MS=45000
# Rodar Lighthouse nas auditorias (true/false). Desligue para auditorias mais rápidas.
AUDIT_LIGHTHOUSE=true
